<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="AI-Generated Sanity Test Suite" verbose="1">
    
    <listeners>
        <listener class-name="utilities.ExtentReportManager"/>
    </listeners>
    
    <!-- Run only AI-recommended sanity tests -->
    <groups>
        <run>
            <include name="sanity"/>
        </run>
    </groups>
    
    <test thread-count="3" name="Sanity Tests - Critical Functionality" parallel="methods">
        <parameter name="browser" value="chrome"/>
        <parameter name="os" value="Windows"/>
        
        <classes>
            <!-- Existing tests with sanity groups -->
            <class name="testCases.AccountCreationTest"/>
            <class name="testCases.LoginwithPropertiesTest"/>
            
            <!-- AI-generated test scenarios -->
            <class name="testCases.AIGeneratedTestsExample">
                <methods>
                    <!-- Only include sanity-tagged tests -->
                    <include name="testUserAuthenticationAfterOAuthMigration"/>
                    <include name="testAccountRegistrationWithEmailVerification"/>
                </methods>
            </class>
        </classes>
    </test>
    
</suite>
